# All optional. Unset values fall back to the defaults shown in comments.

# Path to the Claude Code CLI (default: ~/.local/bin/claude)
HARNESS_CLAUDE_BIN=
# Pin one model for every agent.mjs call: haiku | sonnet | opus | claude-* id
HARNESS_MODEL=
# Pin reasoning effort for agent.mjs: low | medium | high | xhigh (default: chosen per task)
HARNESS_REASONING_EFFORT=
# Folder of Markdown notes injected as advisory personal context (default: ./context/example)
HARNESS_CONTEXT_DIR=
# Working directory for agent.mjs calls (default: current directory)
HARNESS_AGENT_CWD=
# Kit root: always writable in execute mode, and the base for the default context folder (default: this checkout)
HARNESS_ROOT=

# quality-audit.mjs
HARNESS_JUDGE_MODEL=
# JSONL of submissions to audit (default: ./data/example/submissions.jsonl)
QA_SUBMISSIONS=
# Folder of profile facts the judge checks claims against (default: ./context/example)
QA_FACTS_DIR=
# Where audits and human labels are appended (default: ./data/outcomes)
QA_OUTCOMES_DIR=
